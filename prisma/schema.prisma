generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteRequest {
  id        Int      @id @default(autoincrement())
  name      String
  company   String?
  country   String?
  email     String
  phone     String?
  product   String?
  quantity  String
  message   String?
  locale    String   @default("fr")
  ipHash    String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([ipHash, createdAt])
}

model SubmissionRateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id             Int           @id @default(autoincrement())
  locale         String        @default("fr")
  slug           String
  title          String
  excerpt        String
  content        String
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?
  author         String        @default("AL MUMAYIZ")
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([status, publishedAt])
  @@index([locale, status, publishedAt])
}
